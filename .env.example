# Supabase Configuration for Nursury E-Commerce
# Replace these placeholder values with your real project credentials from https://app.supabase.com -> Project Settings -> API

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Publishable / Anon Key (publicly safe, used with Row Level Security)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-here
# Alternative name also supported:
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY or database password in frontend code!
